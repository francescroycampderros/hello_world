{# [module]/templates/my-template.html.twig #}

{% if found == true %}
 
    <p>We are going to send you the booklet to: {{ address }}, {{city}}, {{postal_code}}, {{country}}</p>

    <a class="button" style="display: flex; justify-content: center; margin-left:60px; margin-right:60px" href="bye?cid={{ cid }}&dni={{ dni }}">Yes, I want to continue receveing booklets in this address!</a>

    <p> If the address is not correct, send an email to <a href="mailto:quaderns@fespinal.com">quaderns@fespinal.com</a></p>
	
{% else %}

    <p>Something went wrong. Send an email to <a href="mailto:quaderns@fespinal.com">quaderns@fespinal.com</a></p>

{% endif %}