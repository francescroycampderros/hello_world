{# [module]/templates/my-template-2.html.twig #}

{% if created == true %}
 
    <h3>Thank you for your feedback!</h3>

    <p>We are going to continue sending you the booklets to:</p>

    <ul>
        <li><strong>Address: {{ address }}</strong></li>
        <li><strong>City: {{city}}</strong></li>
        <li><strong>Postal code: {{postal_code}}</strong></li>
        <li><strong>Country: {{country}}</strong></li>
    </ul>

    <p> If the address is not correct, send an email to <a href="mailto:quaderns@fespinal.com">quaderns@fespinal.com</a></p>

{% else %}

    <p>Something went wrong. Send an email to <a href="mailto:quaderns@fespinal.com">quaderns@fespinal.com</a></p>

{% endif %}